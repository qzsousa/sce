# Segredos do backend do SCE -> Google Secret Manager.
#
#   cp secrets.example.env secrets.env
#   ./deploy/deploy-sce.ps1 -ProjectId portal-ure -SecretsFile deploy/secrets.env
#
# O script cria um secret por linha, com o nome `sce-<chave em kebab-case>`
# (SUPABASE_ANON_KEY vira sce-supabase-anon-key) e injeta via --set-secrets.
# Os valores sao lidos do seu sce/.env atual. NAO vao para o git nem para a
# imagem do container.

# URL do projeto Supabase. Vai como secret aqui so por convencao; e uma URL
# publica, se preferir deixar no env-producao.yaml funciona igual.
SUPABASE_URL=

# Chave anonima (respectiva ao papel "anon"). Usada pelo client de leitura.
SUPABASE_ANON_KEY=

# service_role. USADO PELO BACKEND - tem bypass de RLS. Nunca exponha no
# frontend nem no bundle do Vite.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o backend de chamados.
#
# IMPORTANTE: o server.js:80 faz jwt.verify(token, SSO_SECRET) sobre o access
# token EMITIDO pelo backend de chamados. Este valor tem que ser IDENTICO ao
# JWT_SECRET de lá. Se divergir, o login no portal funciona mas toda chamada ao
# SCE volta 401 - falha bem confusa de diagnosticar.
SSO_SECRET=

# Chave de autenticacao do sync de usuarios portal -> SCE. Precisa ser igual
# ao SCE_SYNC_KEY do backend de chamados (que injeta o header de sync).
SCE_SYNC_KEY=
