{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://sce-nyjc.onrender.com/api/$1" },
    { "source": "/pages/(.*)", "destination": "/pages/$1.html" }
  ]
}